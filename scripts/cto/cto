#!/usr/bin/env bash
# One command for the whole loop.
#
#   cto new "what you want"            file a control issue (GPT writes it) in the default repo
#   cto new owner/repo "what you want" ... in another repo
#   cto status 55                      where issue #55 is: state, PR, CI, CTO verdict, last events
#   cto list                           every open control issue across your repos, plus PRs waiting on you
#   cto watch 55                       re-print status every 30 s until it needs you
#   cto onboard owner/repo [--verify "npm test"] [--direct]   connect another repo (files, secret, labels, PR)
#   cto repos                          list your repos and whether each is connected
#   cto bump [--direct]                re-pin every connected repo to the current ai-dispatch main (PR per repo)
#   cto go 55 [build|debug|qa|...] ["guidance"]   approve a Proposed/Blocked issue: posts `CTO: GO` (dispatches)
#   cto block 55 "reason"              keep it Blocked for your decision: posts `CTO: BLOCK`
#   cto deploy 55                      ship a Done issue: adds the `DEPLOY TO PROD` label
#   cto retry 55                       put a Blocked/Review issue back to Ready so it dispatches again
#   cto assign 51 build                CTO assignment: Agent Claude + Skill + labels, State Ready (dispatches)
#   cto handback 55 57                 manual hand-back: issue -> Review with PR #57, PR gets cto:review
#
# Config: ~/.cto/config -> CTO_OWNER, CTO_DEFAULT_REPO (owner/repo).
set -euo pipefail
CTO_HOME="${CTO_HOME:-$HOME/.cto}"
[ -f "$CTO_HOME/config" ] && . "$CTO_HOME/config"
CTO_OWNER="${CTO_OWNER:-devsoliadata-creator}"
CTO_DEFAULT_REPO="${CTO_DEFAULT_REPO:-$CTO_OWNER/personal_assistant}"
# resolve the symlink ~/.local/bin/cto back to the real script directory
self="$0"; [ -L "$self" ] && self="$(readlink "$self")"
here="$(cd "$(dirname "$self")" && pwd)"

field() { sed -n "s/^\*\*$1:\*\*[[:space:]]*//p" | head -1; }

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

cmd_new() {
  local repo="$CTO_DEFAULT_REPO" desc="${1:-}"
  if [[ "${1:-}" == */* && -n "${2:-}" ]]; then repo="$1"; desc="$2"; fi
  [ -n "$desc" ] || usage
  exec bash "$here/cto-new.sh" "$repo" "$desc"
}

cmd_status() {
  local n="${1:?issue number}" repo="${2:-$CTO_DEFAULT_REPO}"
  local body; body="$(gh issue view "$n" -R "$repo" --json body --jq .body)"
  local state agent skill pr blocker next
  state="$(field State <<<"$body")"; agent="$(field Agent <<<"$body")"; skill="$(field Skill <<<"$body")"
  pr="$(field PR <<<"$body")"; blocker="$(field Blocker <<<"$body")"; next="$(field Next <<<"$body")"
  printf '%s#%s  %s\n' "$repo" "$n" "$(gh issue view "$n" -R "$repo" --json title --jq .title)"
  printf '  State: %-12s Agent/Skill: %s / %s\n  Blocker: %s\n  Next: %s\n' "$state" "$agent" "$skill" "$blocker" "$next"
  if [[ "$pr" =~ \#([0-9]+) ]]; then
    local pn="${BASH_REMATCH[1]}"
    local pj; pj="$(gh pr view "$pn" -R "$repo" --json url,state,isDraft,labels,statusCheckRollup,comments)"
    printf '  PR #%s: %s %s%s\n' "$pn" "$(jq -r .state <<<"$pj")" "$(jq -r '.labels|map(.name)|join(",")' <<<"$pj")" "$(jq -r 'if .isDraft then " (draft)" else "" end' <<<"$pj")"
    printf '      %s\n' "$(jq -r .url <<<"$pj")"
    jq -r '.statusCheckRollup[]? | "      check: \(.name // .context) \(.conclusion // .state)"' <<<"$pj"
    jq -r '[.comments[] | select(.body | test("^\\s*CTO:"))] | last | if . then "      verdict: " + (.body | split("\n")[0]) + "  (" + .createdAt + ")" else "      verdict: none yet" end' <<<"$pj"
  else
    printf '  PR: none yet\n'
  fi
  printf '  Last dispatch runs:\n'
  gh run list -R "$repo" -L 3 --workflow ai-dispatch.yml --json event,status,conclusion,createdAt \
    --jq '.[] | "      \(.createdAt) \(.event) \(.status) \(.conclusion // "")"'
  case "$state" in
    Blocked) printf '\n  >> NEEDS YOU: %s\n' "$blocker" ;;
    Review) [[ "$next" == *merge* ]] && printf '\n  >> NEEDS YOU: merge the PR\n' || printf '\n  waiting on the CTO verdict (Mac must be awake)\n' ;;
    Done) printf '\n  done.\n' ;;
    "In Progress") printf '\n  Claude is working; check back in a few minutes.\n' ;;
    Ready) printf '\n  queued; dispatch fires on the next issue event (or: gh workflow run ai-dispatch.yml -f issue=%s)\n' "$n" ;;
    Proposed) printf '\n  >> NEEDS APPROVAL: cto go %s [skill] ["guidance"]  (or the CTO triages it if cto:triage is on)\n' "$n" ;;
  esac
}

cmd_go() {
  local n="${1:?issue number}" skill="${2:-}" note="${3:-}" repo="${CTO_DEFAULT_REPO}"
  case "$skill" in ""|build|debug|qa|review|research|data) ;; *) note="$skill"; skill="" ;; esac
  local line="CTO: GO agent=Claude"; [ -n "$skill" ] && line="$line skill=$skill"
  gh issue comment "$n" -R "$repo" --body "$line"$'\n'"$note" >/dev/null
  echo "#$n: posted '$line' -> Ready; the verdict workflow starts the dispatch." && sleep 5 && cmd_status "$n" "$repo"
}

cmd_block() {
  local n="${1:?issue number}" reason="${2:?reason}" repo="${CTO_DEFAULT_REPO}"
  gh issue comment "$n" -R "$repo" --body "CTO: BLOCK $reason" >/dev/null
  echo "#$n: blocked for your decision ($reason)."
}

cmd_deploy() {
  local n="${1:?issue number}" repo="${CTO_DEFAULT_REPO}"
  local state; state="$(gh issue view "$n" -R "$repo" --json body --jq .body | field State)"
  [ "$state" = "Done" ] || { echo "#$n is $state, not Done -- merge the CTO-approved PR first."; exit 1; }
  gh issue edit "$n" -R "$repo" --add-label "DEPLOY TO PROD" >/dev/null
  echo "#$n: DEPLOY TO PROD label added; the deploy workflow starts within a minute (watch: gh run list -R $repo -L 3)."
}

cmd_list() {
  printf 'OPEN CONTROL ISSUES (%s)\n' "$CTO_OWNER"
  gh search issues --owner "$CTO_OWNER" --state open "Current status" --match body --limit 50 \
    --json repository,number,title,body,url --jq '.[] | [.repository.nameWithOwner, .number, .title, .body] | @tsv' \
  | while IFS=$'\t' read -r repo num title body; do
      b="$(printf '%b' "$body")"
      printf '  %-12s #%-4s %-13s %-8s PR:%-6s %s\n' "${repo#*/}" "$num" "$(field State <<<"$b")" "$(field Skill <<<"$b")" "$(field PR <<<"$b")" "${title:0:60}"
    done
  printf '\nPRS WAITING ON YOU (cto:approved)\n'
  gh search prs --owner "$CTO_OWNER" --state open --label cto:approved --limit 20 --json repository,number,title,url \
    --jq '.[] | "  \(.repository.nameWithOwner)#\(.number) \(.title)\n      \(.url)"'
  printf '\nISSUES AWAITING CTO GO/BLOCK (cto:triage)\n'
  gh search issues --owner "$CTO_OWNER" --state open --label cto:triage --limit 20 --json repository,number,title \
    --jq '.[] | "  \(.repository.nameWithOwner)#\(.number) \(.title)"'
  printf '\nPRS AWAITING CTO VERDICT (cto:review)\n'
  gh search prs --owner "$CTO_OWNER" --state open --label cto:review --limit 20 --json repository,number,title \
    --jq '.[] | "  \(.repository.nameWithOwner)#\(.number) \(.title)"'
}

cmd_watch() {
  local n="${1:?issue number}" repo="${2:-$CTO_DEFAULT_REPO}"
  while true; do
    clear; date; echo; cmd_status "$n" "$repo"
    local body state; body="$(gh issue view "$n" -R "$repo" --json body --jq .body)"; state="$(field State <<<"$body")"
    case "$state" in Blocked|Done) break ;; Review) grep -q "JM merge" <<<"$body" && break ;; esac
    sleep 30
  done
}

cmd_bump() {
  local direct=0; [ "${1:-}" = "--direct" ] && direct=1
  local sha; sha="$(gh api repos/$CTO_OWNER/ai-dispatch/commits/main --jq .sha)"
  echo "ai-dispatch main = ${sha:0:12}"
  gh repo list "$CTO_OWNER" --limit 100 --no-archived --json nameWithOwner --jq '.[].nameWithOwner' | while read -r r; do
    gh api "repos/$r/contents/.github/workflows/ai-dispatch.yml" >/dev/null 2>&1 || continue
    local dir="${CTO_WORKDIR:-$CTO_HOME/repos}/${r#*/}"
    [ -d "$dir/.git" ] || gh repo clone "$r" "$dir" -- --quiet
    local default; default="$(gh repo view "$r" --json defaultBranchRef --jq .defaultBranchRef.name)"
    git -C "$dir" fetch --quiet origin "$default" && git -C "$dir" checkout --quiet -B chore/ai-dispatch-bump "origin/$default"
    local changed; changed="$(python3 "$here/pin.py" "$dir" "$sha")"
    if [ "$changed" = "already pinned" ]; then echo "  $r: already at ${sha:0:12}"; continue; fi
    git -C "$dir" add -A && git -C "$dir" -c user.name=JM -c user.email=dev.soliadata@gmail.com commit -q -m "Pin ai-dispatch to ${sha:0:12}"
    if [ "$direct" = 1 ]; then git -C "$dir" push --quiet origin "HEAD:$default" && echo "  $r: pushed to $default"
    else git -C "$dir" push --quiet -f -u origin chore/ai-dispatch-bump && echo "  $r: $(gh pr create --repo "$r" --base "$default" --title "Pin ai-dispatch to ${sha:0:12}" --body "Reviewed shared-layer upgrade. Diff: https://github.com/$CTO_OWNER/ai-dispatch/compare/$(grep -o 'ai-dispatch/.github/workflows/dispatch.yml@[0-9a-f]*' <(git -C "$dir" show "origin/$default:.github/workflows/ai-dispatch.yml") | head -1 | cut -d@ -f2)...$sha" 2>/dev/null || echo "PR exists")"; fi
  done
}

cmd_retry() {
  local n="${1:?issue number}" repo="${2:-$CTO_DEFAULT_REPO}"
  local body; body="$(gh issue view "$n" -R "$repo" --json body --jq .body)"
  local new; new="$(printf '%s' "$body" | sed -E 's/^\*\*State:\*\*.*/**State:** Ready/; s/^\*\*Blocker:\*\*.*/**Blocker:** None/; s/^\*\*Next:\*\*.*/**Next:** Worker executing/; s/^\*\*Agent:\*\* Unassigned/**Agent:** Claude/')"
  gh issue edit "$n" -R "$repo" --body "$new" >/dev/null && echo "#$n set to Ready; dispatch fires on this edit event." && sleep 3 && cmd_status "$n" "$repo"
}

cmd_assign() {
  local n="${1:?issue number}" skill="${2:?skill: build|debug|review|qa|research|data}" repo="${3:-$CTO_DEFAULT_REPO}"
  local Skill; Skill="$(tr '[:lower:]' '[:upper:]' <<<"${skill:0:1}")${skill:1}"; [ "$skill" = "qa" ] && Skill="QA"
  local body; body="$(gh issue view "$n" -R "$repo" --json body --jq .body)"
  local new; new="$(printf '%s' "$body" | sed -E "s/^\*\*State:\*\*.*/**State:** Ready/; s/^\*\*Agent:\*\*.*/**Agent:** Claude/; s/^\*\*Skill:\*\*.*/**Skill:** $Skill/; s/^\*\*Blocker:\*\*.*/**Blocker:** None/; s/^\*\*Next:\*\*.*/**Next:** Worker executing/")"
  local old_labels; old_labels="$(gh issue view "$n" -R "$repo" --json labels --jq '[.labels[].name | select(startswith("agent:") or startswith("skill:"))] | join(",")')"
  [ -n "$old_labels" ] && gh issue edit "$n" -R "$repo" --remove-label "$old_labels" >/dev/null
  gh issue edit "$n" -R "$repo" --body "$new" --add-label "agent:claude,skill:$skill" >/dev/null
  echo "#$n -> Ready / Claude / $Skill; dispatch fires now." && sleep 3 && cmd_status "$n" "$repo"
}

cmd_handback() {
  local n="${1:?issue number}" pr="${2:?pr number}" repo="${3:-$CTO_DEFAULT_REPO}"
  local body; body="$(gh issue view "$n" -R "$repo" --json body --jq .body)"
  local new; new="$(printf '%s' "$body" | sed -E "s/^\*\*State:\*\*.*/**State:** Review/; s/^\*\*PR:\*\*.*/**PR:** #$pr/; s/^\*\*Blocker:\*\*.*/**Blocker:** None/; s/^\*\*Next:\*\*.*/**Next:** CTO review/")"
  gh issue edit "$n" -R "$repo" --body "$new" >/dev/null
  gh pr edit "$pr" -R "$repo" --add-label cto:review >/dev/null
  echo "#$n -> Review with PR #$pr; PR labeled cto:review (GPT verdict within ~5 min while the Mac is awake)."
}

cmd_repos() {
  gh repo list "$CTO_OWNER" --limit 100 --no-archived --json nameWithOwner,isPrivate,pushedAt --jq '.[] | [.nameWithOwner, (if .isPrivate then "private" else "public" end), .pushedAt[:10]] | @tsv' \
  | while IFS=$'\t' read -r r vis pushed; do
      if gh api "repos/$r/contents/.github/workflows/ai-dispatch.yml" >/dev/null 2>&1; then st="connected"; else st="-"; fi
      printf '  %-45s %-8s %s  %s\n' "$r" "$vis" "$pushed" "$st"
    done
}

case "${1:-}" in
  new) shift; cmd_new "$@" ;;
  onboard) shift; exec bash "$here/onboard-repo.sh" "$@" ;;
  repos) cmd_repos ;;
  bump) shift; cmd_bump "$@" ;;
  go) shift; cmd_go "$@" ;;
  block) shift; cmd_block "$@" ;;
  deploy) shift; cmd_deploy "$@" ;;
  retry) shift; cmd_retry "$@" ;;
  assign) shift; cmd_assign "$@" ;;
  handback) shift; cmd_handback "$@" ;;
  status|st) shift; cmd_status "$@" ;;
  list|ls) cmd_list ;;
  watch) shift; cmd_watch "$@" ;;
  *) usage ;;
esac
